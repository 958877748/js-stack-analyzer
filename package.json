{
  "name": "js-stack-analyzer",
  "version": "1.0.0",
  "description": "JS 堆栈解析器 - 根据错误堆栈定位源码位置并展示上下文",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "pkg . --target node18-win-x64 --output dist/js-stack-analyzer.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "js-beautify": "^1.14.9"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
